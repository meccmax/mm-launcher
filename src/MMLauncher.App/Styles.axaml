<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1" />
  </Style>
  <Style Selector="TextBlock.value">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,3,0,0" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource Orange}" />
    <Setter Property="Foreground" Value="#0D0D0F" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="18,8" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#FF9533" />
    <Setter Property="Foreground" Value="#0D0D0F" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="#4D2C10" />
    <Setter Property="Foreground" Value="#A07A5A" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource Silver}" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Panel2}" />
    <Setter Property="BorderBrush" Value="{StaticResource Orange}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Orange}" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource OrangeSoft}" />
    <Setter Property="Foreground" Value="{StaticResource Orange}" />
  </Style>

  <!-- Server list -->
  <Style Selector="ListBox.servers">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.servers ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="ListBox.servers ListBoxItem /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Panel2}" />
  </Style>
  <Style Selector="ListBox.servers ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#24242A" />
  </Style>
  <Style Selector="ListBox.servers ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="#2A1D12" />
  </Style>
  <Style Selector="ListBox.servers ListBoxItem:selected Border.accent">
    <Setter Property="Background" Value="{StaticResource Orange}" />
  </Style>

  <!-- Mod list -->
  <Style Selector="ListBox.mods">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.mods ListBoxItem">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ListBox.mods ListBoxItem:nth-child(2n) /template/ ContentPresenter">
    <Setter Property="Background" Value="#141417" />
  </Style>
  <Style Selector="ListBox.mods ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="#24242A" />
  </Style>

  <!-- Status dot -->
  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Fill" Value="{StaticResource Muted}" />
  </Style>
  <Style Selector="Ellipse.dot.online">
    <Setter Property="Fill" Value="{StaticResource Good}" />
  </Style>
  <Style Selector="Ellipse.dot.offline">
    <Setter Property="Fill" Value="{StaticResource Bad}" />
  </Style>

  <!-- Ping colour -->
  <Style Selector="TextBlock.ping">
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
  </Style>
  <Style Selector="TextBlock.ping.good"><Setter Property="Foreground" Value="{StaticResource Good}" /></Style>
  <Style Selector="TextBlock.ping.ok"><Setter Property="Foreground" Value="{StaticResource Warn}" /></Style>
  <Style Selector="TextBlock.ping.bad"><Setter Property="Foreground" Value="{StaticResource Bad}" /></Style>

  <!-- Mod status pill -->
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Background" Value="#2A2A31" />
  </Style>
  <Style Selector="Border.pill TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Silver}" />
  </Style>
  <Style Selector="Border.pill.installed"><Setter Property="Background" Value="#16351F" /></Style>
  <Style Selector="Border.pill.installed TextBlock"><Setter Property="Foreground" Value="{StaticResource Good}" /></Style>
  <Style Selector="Border.pill.update"><Setter Property="Background" Value="#3A2C0E" /></Style>
  <Style Selector="Border.pill.update TextBlock"><Setter Property="Foreground" Value="{StaticResource Warn}" /></Style>
  <Style Selector="Border.pill.missing"><Setter Property="Background" Value="#3D1916" /></Style>
  <Style Selector="Border.pill.missing TextBlock"><Setter Property="Foreground" Value="{StaticResource Bad}" /></Style>

  <!-- Stat tiles -->
  <Style Selector="Border.tile">
    <Setter Property="Background" Value="{StaticResource Panel2}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="Margin" Value="0,0,8,8" />
    <Setter Property="MinWidth" Value="118" />
  </Style>

  <!-- Download / launch panel -->
  <Style Selector="Border.sync">
    <Setter Property="Background" Value="{StaticResource Panel2}" />
    <Setter Property="BorderBrush" Value="{StaticResource Orange}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="14,10" />
  </Style>
  <Style Selector="Border.sync.failed">
    <Setter Property="Background" Value="#2B1513" />
    <Setter Property="BorderBrush" Value="{StaticResource Bad}" />
  </Style>
  <Style Selector="Border.sync.failed TextBlock.synctitle"><Setter Property="Foreground" Value="{StaticResource Bad}" /></Style>
  <Style Selector="Border.sync.done">
    <Setter Property="Background" Value="#132A19" />
    <Setter Property="BorderBrush" Value="{StaticResource Good}" />
  </Style>
  <Style Selector="Border.sync.done TextBlock.synctitle"><Setter Property="Foreground" Value="{StaticResource Good}" /></Style>

  <Style Selector="ProgressBar.players">
    <Setter Property="Foreground" Value="{StaticResource Orange}" />
    <Setter Property="Background" Value="#2A2A31" />
    <Setter Property="Height" Value="4" />
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="1" />
  </Style>
</Styles>
