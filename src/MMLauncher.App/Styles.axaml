<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1" />
  </Style>
  <Style Selector="TextBlock.value">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,3,0,0" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Orange}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="18,8" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHover}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentDisabled}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentDisabledText}" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Silver}" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Panel2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Orange}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Orange}" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource OrangeSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource Orange}" />
  </Style>

  <Style Selector="TextBlock.value.soon"><Setter Property="Foreground" Value="{DynamicResource Warn}" /></Style>

  <!-- List tabs -->
  <Style Selector="Button.tab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="2,8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
  </Style>
  <Style Selector="Button.tab:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Panel2}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
  </Style>
  <Style Selector="Button.tab.active">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Orange}" />
  </Style>
  <Style Selector="Button.tab.page">
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.tab.page.active">
    <Setter Property="BorderBrush" Value="{DynamicResource Orange}" />
  </Style>
  <Style Selector="Button.tab.unseen">
    <Setter Property="Foreground" Value="{DynamicResource Orange}" />
  </Style>
  <!-- small "NEW" badge on server rows with unseen news -->
  <Style Selector="Border.newbadge">
    <Setter Property="Background" Value="{DynamicResource Orange}" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.newbadge TextBlock">
    <Setter Property="FontSize" Value="9" />
    <Setter Property="FontWeight" Value="Black" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="Button.tab.active:pointerover /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Orange}" />
  </Style>

  <!-- Server list -->
  <Style Selector="ListBox.servers">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.servers ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="ListBox.servers ListBoxItem /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Panel2}" />
  </Style>
  <Style Selector="ListBox.servers ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Hover}" />
  </Style>
  <Style Selector="ListBox.servers ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentTint}" />
  </Style>
  <Style Selector="ListBox.servers ListBoxItem:selected Border.accent">
    <Setter Property="Background" Value="{DynamicResource Orange}" />
  </Style>

  <!-- Mod list -->
  <Style Selector="ListBox.mods">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.mods ListBoxItem">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ListBox.mods ListBoxItem:nth-child(2n) /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Stripe}" />
  </Style>
  <Style Selector="ListBox.mods ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Hover}" />
  </Style>

  <!-- Status dot -->
  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Fill" Value="{DynamicResource Muted}" />
  </Style>
  <Style Selector="Ellipse.dot.online">
    <Setter Property="Fill" Value="{DynamicResource Good}" />
  </Style>
  <Style Selector="Ellipse.dot.offline">
    <Setter Property="Fill" Value="{DynamicResource Bad}" />
  </Style>

  <!-- Ping colour -->
  <Style Selector="TextBlock.ping">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>
  <Style Selector="TextBlock.ping.good"><Setter Property="Foreground" Value="{DynamicResource Good}" /></Style>
  <Style Selector="TextBlock.ping.ok"><Setter Property="Foreground" Value="{DynamicResource Warn}" /></Style>
  <Style Selector="TextBlock.ping.bad"><Setter Property="Foreground" Value="{DynamicResource Bad}" /></Style>

  <!-- Mod status pill -->
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Background" Value="{DynamicResource Line}" />
  </Style>
  <Style Selector="Border.pill TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Silver}" />
  </Style>
  <Style Selector="Border.pill.installed"><Setter Property="Background" Value="{DynamicResource GoodTint}" /></Style>
  <Style Selector="Border.pill.installed TextBlock"><Setter Property="Foreground" Value="{DynamicResource Good}" /></Style>
  <Style Selector="Border.pill.update"><Setter Property="Background" Value="{DynamicResource WarnTint}" /></Style>
  <Style Selector="Border.pill.update TextBlock"><Setter Property="Foreground" Value="{DynamicResource Warn}" /></Style>
  <Style Selector="Border.pill.missing"><Setter Property="Background" Value="{DynamicResource BadTint}" /></Style>
  <Style Selector="Border.pill.missing TextBlock"><Setter Property="Foreground" Value="{DynamicResource Bad}" /></Style>

  <!-- Stat tiles -->
  <Style Selector="Border.tile">
    <Setter Property="Background" Value="{DynamicResource Panel2}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="Margin" Value="0,0,8,8" />
    <Setter Property="MinWidth" Value="118" />
  </Style>

  <!-- Download / launch panel -->
  <Style Selector="Border.sync">
    <Setter Property="Background" Value="{DynamicResource Panel2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Orange}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="14,10" />
  </Style>
  <Style Selector="Border.sync.failed">
    <Setter Property="Background" Value="{DynamicResource BadTintSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Bad}" />
  </Style>
  <Style Selector="Border.sync.failed TextBlock.synctitle"><Setter Property="Foreground" Value="{DynamicResource Bad}" /></Style>
  <Style Selector="Border.sync.warn">
    <Setter Property="Background" Value="{DynamicResource WarnTintSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Warn}" />
  </Style>
  <Style Selector="Border.sync.warn TextBlock.synctitle"><Setter Property="Foreground" Value="{DynamicResource Warn}" /></Style>
  <Style Selector="Border.sync.done">
    <Setter Property="Background" Value="{DynamicResource GoodTintSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Good}" />
  </Style>
  <Style Selector="Border.sync.done TextBlock.synctitle"><Setter Property="Foreground" Value="{DynamicResource Good}" /></Style>

  <Style Selector="ProgressBar.players">
    <Setter Property="Foreground" Value="{DynamicResource Orange}" />
    <Setter Property="Background" Value="{DynamicResource Line}" />
    <Setter Property="Height" Value="4" />
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="1" />
  </Style>
</Styles>
