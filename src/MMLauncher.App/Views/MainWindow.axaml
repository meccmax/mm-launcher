<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MMLauncher.App.ViewModels"
        xmlns:ed="using:MMLauncher.Core.Editor"
        xmlns:ctl="using:MMLauncher.App.Controls"
        x:Class="MMLauncher.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="MM Launcher — Misfit Mercenaries"
        Icon="avares://MMLauncher/Assets/mm.ico"
        Width="1200" Height="780" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ============ Header ============ -->
    <Border Grid.Row="0" Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Orange}" BorderThickness="0,0,0,2" Padding="18,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Image Source="avares://MMLauncher/Assets/mm.png" Width="40" Height="40" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="MISFIT MERCENARIES" FontSize="19" FontWeight="Black" LetterSpacing="1.5" Foreground="{DynamicResource Orange}" />
            <TextBlock Text="SERVER LAUNCHER" FontSize="11" FontWeight="SemiBold" LetterSpacing="4" Foreground="{DynamicResource Silver}" />
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom" Margin="34,0,0,-12">
          <Button Classes="tab page" Classes.active="{Binding IsServersPage}" Content="SERVERS" Command="{Binding ShowServersPageCommand}" />
          <Button Classes="tab page" Classes.active="{Binding IsEditorPage}" Content="DAYZ EDITOR" Command="{Binding ShowEditorPageCommand}"
                  ToolTip.Tip="Start DayZ offline with the DayZ Editor and a preset of mods" />
          <Button Classes="tab page" Classes.active="{Binding IsModsPage}" Content="MODS" Command="{Binding ShowModsPageCommand}"
                  ToolTip.Tip="Your downloaded mods (update, remove), and the Steam Workshop" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <!-- Short label so the header still fits next to Refresh; the version is in the tooltip. -->
          <Button Classes="primary" Content="Update" Command="{Binding UpdateNowCommand}" Padding="14,8"
                  IsVisible="{Binding UpdateAvailable}" IsEnabled="{Binding !Updating}"
                  ToolTip.Tip="{Binding UpdateButtonText}" />
          <Button Classes="ghost" Content="Report a problem" Command="{Binding ReportProblemCommand}"
                  ToolTip.Tip="Crashed or kicked? Bundle the logs and send them to staff" />
          <Button Classes="ghost" Content="Settings" Command="{Binding OpenSettingsCommand}"
                  ToolTip.Tip="Folders, launch options and maintenance" />
          <Button Classes="ghost" Content="Rescan" Command="{Binding RescanCommand}"
                  ToolTip.Tip="Scan the MM hosts again for new or moved servers" />
          <Button Classes="primary" Content="Refresh" Command="{Binding RefreshCommand}"
                  ToolTip.Tip="Update player counts, ping and mod status now" />
        </StackPanel>

        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
          <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource Silver}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding LastRefreshText}" HorizontalAlignment="Right" FontSize="11" Classes="muted" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ============ Body: servers ============ -->
    <Grid Grid.Row="1" ColumnDefinitions="390,*" IsVisible="{Binding IsServersPage}">

      <!-- Server lists: MM / All servers / Favorites / Recent -->
      <Border Grid.Column="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="10,10,10,4">
            <Button Grid.Column="0" Classes="tab" Classes.active="{Binding IsMmTab}" Content="MM" Command="{Binding ShowMmTabCommand}"
                    ToolTip.Tip="Misfit Mercenaries servers" Padding="12,8" />
            <Button Grid.Column="1" Classes="tab" Classes.active="{Binding IsAllTab}" Content="All servers" Command="{Binding ShowAllTabCommand}"
                    ToolTip.Tip="Every DayZ server, with search and filters" Padding="12,8" />
            <Button Grid.Column="2" Classes="tab" Classes.active="{Binding IsFriendsTab}" Content="Friends" Command="{Binding ShowFriendsTabCommand}"
                    ToolTip.Tip="Servers your Steam friends are playing on, or were seen on" Padding="12,8" />
            <Button Grid.Column="3" Classes="tab" Classes.active="{Binding IsFavoritesTab}" Content="Favorites" Command="{Binding ShowFavoritesTabCommand}" Padding="12,8" />
            <Button Grid.Column="4" Classes="tab" Classes.active="{Binding IsRecentTab}" Content="Recent" Command="{Binding ShowRecentTabCommand}" Padding="12,8" />
          </Grid>

          <!-- Headers -->
          <TextBlock Grid.Row="1" Classes="label" Text="{Binding ServerCountText}" Margin="16,10,16,10" IsVisible="{Binding IsMmTab}" />
          <StackPanel Grid.Row="1" IsVisible="{Binding IsFriendsTab}" Margin="16,10,12,8" Spacing="4">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="link" Content="Refresh" Command="{Binding RefreshFriendsCommand}" IsEnabled="{Binding !FriendsLoading}" />
              <TextBlock Classes="label" Text="STEAM FRIENDS IN DAYZ" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{Binding FriendsStatus}" FontSize="12" Classes="muted" TextWrapping="Wrap" />
            <TextBlock Text="{Binding FriendsInMenus}" FontSize="12" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasFriendsInMenus}" />
          </StackPanel>
          <TextBlock Grid.Row="1" Classes="label" Text="FAVORITES" Margin="16,10,16,10" IsVisible="{Binding IsFavoritesTab}" />
          <TextBlock Grid.Row="1" Classes="label" Text="RECENTLY PLAYED" Margin="16,10,16,10" IsVisible="{Binding IsRecentTab}" />
          <StackPanel Grid.Row="1" IsVisible="{Binding IsAllTab}" Margin="12,8,12,8" Spacing="6">
            <TextBox Watermark="Search name, map or IP address" Text="{Binding BrowserSearch}" />
            <Grid ColumnDefinitions="*,6,*">
              <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding MapOptions}" SelectedItem="{Binding SelectedMap}"
                        ToolTip.Tip="Map">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:FilterOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" ItemsSource="{Binding SortChoices}" SelectedIndex="{Binding SortIndex}"
                        ToolTip.Tip="Sort by" />
            </Grid>
            <Grid ColumnDefinitions="*,6,*">
              <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding PerspectiveChoices}" SelectedIndex="{Binding PerspectiveIndex}"
                        ToolTip.Tip="Camera: first person only, or third person allowed. Taken from each server's own setting; a few servers force 1PP with a mod instead and show as 3PP here." />
              <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" ItemsSource="{Binding ModsChoices}" SelectedIndex="{Binding ModsIndex}"
                        ToolTip.Tip="Based on the tags each server reports" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="16">
              <CheckBox Content="Hide empty" IsChecked="{Binding HideEmpty}" FontSize="12" />
              <CheckBox Content="Hide full" IsChecked="{Binding HideFull}" FontSize="12" />
            </StackPanel>
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="link" Content="Refresh list" Command="{Binding RefreshBrowserCommand}"
                      IsEnabled="{Binding !BrowserLoading}" ToolTip.Tip="Get a fresh copy of the server list" />
              <TextBlock Text="{Binding BrowserStatus}" FontSize="11" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding BrowserStatus}" />
            </DockPanel>
          </StackPanel>

          <!-- MM servers -->
          <Panel Grid.Row="2" IsVisible="{Binding IsMmTab}">
            <ListBox Classes="servers" Margin="10,0,10,10" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedMmServer}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ServerViewModel">
                <Grid ColumnDefinitions="4,*">
                  <Border Classes="accent" Grid.Column="0" Background="Transparent" CornerRadius="4,0,0,4" />
                  <Grid Grid.Column="1" Margin="12,10" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <Ellipse Grid.Row="0" Grid.Column="0" Classes="dot" Classes.online="{Binding Online}"
                             Classes.offline="{Binding !Online}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <DockPanel Grid.Row="0" Grid.Column="1">
                      <Border DockPanel.Dock="Right" Classes="newbadge" IsVisible="{Binding HasUnseenNews}" ToolTip.Tip="This server has news you haven't read">
                        <TextBlock Text="NEW" />
                      </Border>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                    </DockPanel>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding PingText}" FontSize="12" Margin="10,0,0,0"
                               Classes="ping" Classes.good="{Binding PingGood}" Classes.ok="{Binding PingOk}" Classes.bad="{Binding PingBad}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MapLine}" FontSize="12" Classes="muted" Margin="0,3,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding PlayersText}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Silver}" Margin="10,3,0,0" HorizontalAlignment="Right" />
                    <ProgressBar Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Classes="players" Value="{Binding PlayerFill}"
                                 Margin="0,8,0,0" IsVisible="{Binding Online}" />
                  </Grid>
                </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel VerticalAlignment="Center" Margin="30" Spacing="12" IsVisible="{Binding IsScanning}">
              <ProgressBar IsIndeterminate="True" Foreground="{DynamicResource Orange}" />
              <TextBlock Text="Looking for MM servers…" HorizontalAlignment="Center" FontWeight="SemiBold" />
              <TextBlock Text="{Binding HostsText}" HorizontalAlignment="Center" Classes="muted" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Margin="30" Spacing="10" IsVisible="{Binding NoServers}">
              <TextBlock Text="No servers found" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="15" />
              <TextBlock Text="Check your internet connection, then click Rescan." HorizontalAlignment="Center" Classes="muted"
                         TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
          </Panel>

          <!-- All servers -->
          <Panel Grid.Row="2" IsVisible="{Binding IsAllTab}">
            <ListBox Classes="servers" Margin="10,0,10,10" ItemsSource="{Binding BrowserRows}" SelectedItem="{Binding SelectedBrowserRow}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:BrowserRowViewModel">
                  <Grid ColumnDefinitions="4,*">
                    <Border Classes="accent" Grid.Column="0" Background="Transparent" CornerRadius="4,0,0,4" />
                    <Grid Grid.Column="1" Margin="12,9" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                      <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PingText}" FontSize="12" Margin="10,0,0,0"
                                 Classes="ping" Classes.good="{Binding PingGood}" Classes.ok="{Binding PingOk}" Classes.bad="{Binding PingBad}" />
                      <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding MapLine}" FontSize="12" Classes="muted" Margin="0,3,0,0"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PlayersText}" FontSize="12" FontWeight="SemiBold"
                                 Foreground="{DynamicResource Silver}" Margin="10,3,0,0" HorizontalAlignment="Right" />
                      <ProgressBar Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Classes="players" Value="{Binding PlayerFill}" Margin="0,7,0,0" />
                    </Grid>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel VerticalAlignment="Center" Margin="30" Spacing="12" IsVisible="{Binding BrowserLoading}">
              <ProgressBar IsIndeterminate="True" Foreground="{DynamicResource Orange}" />
              <TextBlock Text="Getting the server list…" HorizontalAlignment="Center" FontWeight="SemiBold" />
            </StackPanel>
          </Panel>

          <!-- Friends -->
          <Panel Grid.Row="2" IsVisible="{Binding IsFriendsTab}">
            <ListBox Classes="servers" Margin="10,0,10,10" ItemsSource="{Binding FriendRows}" SelectedItem="{Binding SelectedFriendRow}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:FriendServerRow">
                  <Grid ColumnDefinitions="4,*">
                    <Border Classes="accent" Grid.Column="0" Background="Transparent" CornerRadius="4,0,0,4" />
                    <Grid Grid.Column="1" Margin="12,10" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding Server}" />
                      <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Badge}" FontSize="10" FontWeight="Bold" Margin="10,0,0,0"
                                 Foreground="{DynamicResource Good}" IsVisible="{Binding Now}" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Badge}" FontSize="11" Margin="10,0,0,0" Classes="muted"
                                 IsVisible="{Binding !Now}" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding FriendsText}" FontSize="12" Foreground="{DynamicResource Silver}"
                                 Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock IsVisible="{Binding NoFriendRows}" Margin="30" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Classes="muted"
                       Text="No friends on DayZ servers right now. Servers you see friends on are remembered here for 30 days." />
            <ProgressBar IsVisible="{Binding FriendsLoading}" IsIndeterminate="True" Foreground="{DynamicResource Orange}" VerticalAlignment="Top" Margin="12,0" Height="3" MinHeight="3" />
          </Panel>

          <!-- Favorites / Recent -->
          <Panel Grid.Row="2" IsVisible="{Binding IsSavedTab}">
            <ListBox Classes="servers" Margin="10,0,10,10" ItemsSource="{Binding SavedServers}" SelectedItem="{Binding SelectedSavedServer}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ServerViewModel">
                <Grid ColumnDefinitions="4,*">
                  <Border Classes="accent" Grid.Column="0" Background="Transparent" CornerRadius="4,0,0,4" />
                  <Grid Grid.Column="1" Margin="12,10" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <Ellipse Grid.Row="0" Grid.Column="0" Classes="dot" Classes.online="{Binding Online}"
                             Classes.offline="{Binding !Online}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <DockPanel Grid.Row="0" Grid.Column="1">
                      <Border DockPanel.Dock="Right" Classes="newbadge" IsVisible="{Binding HasUnseenNews}" ToolTip.Tip="This server has news you haven't read">
                        <TextBlock Text="NEW" />
                      </Border>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                    </DockPanel>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding PingText}" FontSize="12" Margin="10,0,0,0"
                               Classes="ping" Classes.good="{Binding PingGood}" Classes.ok="{Binding PingOk}" Classes.bad="{Binding PingBad}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MapLine}" FontSize="12" Classes="muted" Margin="0,3,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding PlayersText}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Silver}" Margin="10,3,0,0" HorizontalAlignment="Right" />
                    <ProgressBar Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Classes="players" Value="{Binding PlayerFill}"
                                 Margin="0,8,0,0" IsVisible="{Binding Online}" />
                  </Grid>
                </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock IsVisible="{Binding NoFavorites}" Margin="30" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Classes="muted"
                       Text="No favorites yet. Pick a server in any list and click ☆ Favorite." />
            <TextBlock IsVisible="{Binding NoRecent}" Margin="30" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Classes="muted"
                       Text="Servers you join show up here." />
          </Panel>
        </Grid>
      </Border>

      <!-- Details -->
      <Grid Grid.Column="1" IsVisible="{Binding HasSelection}" RowDefinitions="Auto,Auto,Auto,*" Margin="26,20,26,12">

        <StackPanel Grid.Row="0" DataContext="{Binding SelectedServer}" x:DataType="vm:ServerViewModel" Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Ellipse Classes="dot" Classes.online="{Binding Online}" Classes.offline="{Binding !Online}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}" Classes="label" VerticalAlignment="Center" />
            <Border Background="{DynamicResource BadTint}" CornerRadius="3" Padding="6,1" IsVisible="{Binding Passworded}">
              <TextBlock Text="PASSWORD" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Bad}" />
            </Border>
          </StackPanel>
          <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />
          <SelectableTextBlock Text="{Binding PortsText}" Classes="muted" FontSize="12" Foreground="{DynamicResource Muted}" />
          <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).FriendsOnSelected}" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource Good}" TextWrapping="Wrap"
                     IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).HasFriendsOnSelected}" />
          <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                     IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <Border Background="{DynamicResource AccentTint}" BorderBrush="{DynamicResource Orange}" BorderThickness="3,0,0,0" CornerRadius="3"
                  Padding="12,8" Margin="0,8,0,0" IsVisible="{Binding HasMessage}" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="13" />
          </Border>

          <WrapPanel Margin="0,14,0,0">
            <Border Classes="tile" MinWidth="150">
              <StackPanel>
                <TextBlock Classes="label" Text="PLAYERS" />
                <TextBlock Classes="value" Text="{Binding PlayersText}" />
                <ProgressBar Classes="players" Value="{Binding PlayerFill}" Margin="0,6,0,0" />
              </StackPanel>
            </Border>
            <Border Classes="tile"><StackPanel><TextBlock Classes="label" Text="QUEUE" /><TextBlock Classes="value" Text="{Binding QueueText}" /></StackPanel></Border>
            <Border Classes="tile"><StackPanel><TextBlock Classes="label" Text="MAP" /><TextBlock Classes="value" Text="{Binding MapText}" /></StackPanel></Border>
            <Border Classes="tile"><StackPanel><TextBlock Classes="label" Text="IN-GAME TIME" /><TextBlock Classes="value" Text="{Binding TimeText}" /></StackPanel></Border>
            <Border Classes="tile"><StackPanel><TextBlock Classes="label" Text="PING" />
              <TextBlock Classes="value ping" Classes.good="{Binding PingGood}" Classes.ok="{Binding PingOk}" Classes.bad="{Binding PingBad}" Text="{Binding PingText}" /></StackPanel></Border>
            <Border Classes="tile"><StackPanel><TextBlock Classes="label" Text="VIEW" /><TextBlock Classes="value" Text="{Binding Perspective}" /></StackPanel></Border>
            <Border Classes="tile"><StackPanel><TextBlock Classes="label" Text="DLC REQUIRED" /><TextBlock Classes="value" Text="{Binding DlcText}" /></StackPanel></Border>
            <Border Classes="tile"><StackPanel><TextBlock Classes="label" Text="VERSION" /><TextBlock Classes="value" Text="{Binding Version}" /></StackPanel></Border>
            <Border Classes="tile" IsVisible="{Binding ModsFromAgent}"><StackPanel><TextBlock Classes="label" Text="UPTIME" /><TextBlock Classes="value" Text="{Binding UptimeText}" /></StackPanel></Border>
            <Border Classes="tile" IsVisible="{Binding HasRestart}" ToolTip.Tip="From the MM agent's restart schedule. ~ means estimated from when the server last started.">
              <StackPanel><TextBlock Classes="label" Text="NEXT RESTART" />
                <TextBlock Classes="value" Text="{Binding RestartText}" Classes.soon="{Binding RestartSoon}" /></StackPanel></Border>
          </WrapPanel>

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
            <Button Classes="primary" Content="JOIN WHEN READY"
                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).JoinWhenReadyCommand}"
                    IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).CanJoinWhenReady}"
                    ToolTip.Tip="The server is restarting or down. Click to queue up: the launcher waits for it, updates mods and starts DayZ for you. Cancel any time." />
            <Button Classes="primary" Content="JOIN SERVER" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowJoinButton}"
                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).JoinCommand}"
                    IsEnabled="{Binding $parent[Window].((vm:MainViewModel)DataContext).CanJoin}"
                    ToolTip.Tip="Download any missing or outdated mods through Steam, then start DayZ connected to this server" />
            <Button Classes="ghost" Content="Update mods"
                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).UpdateModsCommand}"
                    IsEnabled="{Binding $parent[Window].((vm:MainViewModel)DataContext).CanUpdateMods}"
                    ToolTip.Tip="Download and update this server's mods without joining (e.g. before a wipe)" />
            <Button Classes="ghost" Content="Verify files"
                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).VerifyFilesCommand}"
                    IsEnabled="{Binding $parent[Window].((vm:MainViewModel)DataContext).CanUpdateMods}"
                    ToolTip.Tip="Check this server's downloaded mods for missing or broken files, and repair them" />
            <Button Classes="ghost" Content="Copy address" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CopyAddressCommand}"
                    ToolTip.Tip="{Binding ConnectText}" />
            <Button Classes="ghost" Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).FavoriteText}"
                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleFavoriteCommand}"
                    ToolTip.Tip="Add or remove this server from your Favorites" />
          </StackPanel>

          <CheckBox Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource Silver}"
                    Content="Rejoin automatically if DayZ crashes"
                    IsChecked="{Binding $parent[Window].((vm:MainViewModel)DataContext).AutoRejoin}"
                    ToolTip.Tip="If DayZ crashes, the launcher updates mods and rejoins the server you were on (waiting for it if it's restarting). Quitting DayZ normally never rejoins. You can cancel the countdown." />

          <Border Background="{DynamicResource WarnTint}" BorderBrush="{DynamicResource Warn}" BorderThickness="3,0,0,0" CornerRadius="3" Padding="12,8" Margin="0,10,0,0"
                  IsVisible="{Binding RestartSoon}">
            <TextBlock Text="{Binding RestartWarning}" Foreground="{DynamicResource Warn}" TextWrapping="Wrap" FontSize="12" />
          </Border>
          <Border Background="{DynamicResource WarnTint}" CornerRadius="4" Padding="12,8" Margin="0,10,0,0" IsVisible="{Binding HasError}">
            <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource Warn}" TextWrapping="Wrap" FontSize="12" />
          </Border>
        </StackPanel>

        <!-- Download / launch progress, and the auto-rejoin countdown -->
        <StackPanel Grid.Row="1">
        <Border Classes="sync" IsVisible="{Binding RejoinActive}" Margin="0,14,0,0">
          <StackPanel Spacing="6">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="link" Content="Cancel" Command="{Binding CancelRejoinCommand}" />
              <TextBlock Classes="synctitle" Text="{Binding RejoinTitle}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
            <ProgressBar IsIndeterminate="True" Foreground="{DynamicResource Orange}" Background="{DynamicResource Line}" Height="4" MinHeight="4" />
            <TextBlock Text="{Binding RejoinDetail}" FontSize="12" Foreground="{DynamicResource Silver}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Classes="sync" Classes.failed="{Binding SyncFailed}" Classes.done="{Binding SyncSucceeded}" Classes.warn="{Binding SyncWarning}"
                IsVisible="{Binding ShowSyncPanel}" Margin="0,14,0,0">
          <StackPanel Spacing="8">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="link" Content="Cancel" Command="{Binding CancelSyncCommand}" IsVisible="{Binding IsSyncing}" />
              <Button DockPanel.Dock="Right" Classes="link" Content="Dismiss" Command="{Binding DismissSyncCommand}" IsVisible="{Binding !IsSyncing}" />
              <Button DockPanel.Dock="Right" Classes="link" Content="Open log" Command="{Binding OpenLogCommand}" IsVisible="{Binding SyncFailed}" />
              <TextBlock Classes="synctitle" Text="{Binding SyncTitle}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
            <ProgressBar IsVisible="{Binding IsSyncing}" Minimum="0" Maximum="1" Value="{Binding SyncFraction}"
                         IsIndeterminate="{Binding SyncIndeterminate}" Foreground="{DynamicResource Orange}" Background="{DynamicResource Line}" Height="6" MinHeight="6" />
            <TextBlock Text="{Binding SyncDetail}" FontSize="12" Foreground="{DynamicResource Silver}" TextWrapping="Wrap"
                       IsVisible="{Binding SyncDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0" IsVisible="{Binding HasPanelAction}">
              <Button Classes="primary" Padding="14,5" FontSize="12" Content="{Binding PanelActionText}" Command="{Binding PanelAction}" />
              <Button Classes="ghost" Padding="14,5" FontSize="12" Content="{Binding PanelAction2Text}" Command="{Binding PanelAction2}"
                      IsVisible="{Binding HasPanelAction2}" />
            </StackPanel>
          </StackPanel>
        </Border>
        </StackPanel>

        <!-- Mods header -->
        <StackPanel Grid.Row="2" DataContext="{Binding SelectedServer}" x:DataType="vm:ServerViewModel" Margin="0,22,0,8" Spacing="4">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Classes="label" Text="REQUIRED MODS" VerticalAlignment="Bottom" IsVisible="{Binding !ShowDetailTabs}" />
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="4" IsVisible="{Binding ShowDetailTabs}" Margin="0,0,10,0">
              <Button Classes="tab" Padding="12,6" Content="REQUIRED MODS"
                      Classes.active="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsModsDetails}"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowModsDetailsCommand}" />
              <Button Classes="tab" Padding="12,6" Content="{Binding NewsTabText}" Classes.unseen="{Binding HasUnseenNews}"
                      Classes.active="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsNewsDetails}"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowNewsDetailsCommand}"
                      IsVisible="{Binding HasNews}"
                      ToolTip.Tip="News from MM staff for this server (wipes, events, changes)" />
              <Button Classes="tab" Padding="12,6" Content="PLAYERS"
                      Classes.active="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsPlayersDetails}"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowPlayersDetailsCommand}"
                      IsVisible="{Binding HasHistory}"
                      ToolTip.Tip="How busy this server has been over the last day and week" />
            </StackPanel>
            <DockPanel IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsModsDetails}" VerticalAlignment="Center">
            <Border DockPanel.Dock="Right" Background="{DynamicResource GoodTint}" CornerRadius="10" Padding="9,2" IsVisible="{Binding ModsFromAgent}"
                    ToolTip.Tip="This list comes from the MM Server Agent, which reads the server's own startup line. It is complete.">
              <TextBlock Text="VERIFIED BY MM AGENT" FontSize="10" FontWeight="Bold" LetterSpacing="0.5" Foreground="{DynamicResource Good}" />
            </Border>
            <Border DockPanel.Dock="Right" Background="{DynamicResource Line}" CornerRadius="10" Padding="9,2" IsVisible="{Binding ModsFromServer}"
                    ToolTip.Tip="No MM agent answered for this server, so the list comes from the server's status reply.">
              <TextBlock Text="FROM SERVER STATUS" FontSize="10" FontWeight="Bold" LetterSpacing="0.5" Foreground="{DynamicResource Silver}" />
            </Border>
            <TextBlock Text="{Binding ModSummary}" Foreground="{DynamicResource Silver}" FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ModSummary}" />
            </DockPanel>
          </DockPanel>
          <StackPanel Spacing="4" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsModsDetails}">
          <TextBlock IsVisible="{Binding ShowTruncatedWarning}" Foreground="{DynamicResource Warn}" FontSize="12" TextWrapping="Wrap"
                     Text="This server reported more mods than fit in its status reply, so this list may be incomplete. (Raise steamProtocolMaxDataSize in serverDZ.cfg, or run the MM Server Agent.)" />
          <TextBlock IsVisible="{Binding HasModNote}" Text="{Binding ModNote}" Foreground="{DynamicResource Warn}" FontSize="12" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="112,*,90,120,150" Margin="10,10,10,0">
            <TextBlock Grid.Column="0" Classes="label" Text="STATUS" />
            <TextBlock Grid.Column="1" Classes="label" Text="MOD" />
            <TextBlock Grid.Column="2" Classes="label" Text="SIZE" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="3" Classes="label" Text="UPDATED" HorizontalAlignment="Right" />
          </Grid>
          </StackPanel>
        </StackPanel>

        <!-- Player history -->
        <Border Grid.Row="3" Background="{DynamicResource Panel}" CornerRadius="4" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                IsVisible="{Binding IsPlayersDetails}" Padding="14,10,14,10">
          <Grid RowDefinitions="Auto,*,Auto">
            <DockPanel Grid.Row="0">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                <Button Classes="tab" Padding="10,4" Content="24 hours" Classes.active="{Binding HistoryIsDay}" Command="{Binding ShowHistoryDayCommand}" />
                <Button Classes="tab" Padding="10,4" Content="7 days" Classes.active="{Binding HistoryIsWeek}" Command="{Binding ShowHistoryWeekCommand}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <TextBlock Text="{Binding HistoryPeak}" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="{Binding HistoryAverage}" FontSize="12" Foreground="{DynamicResource Silver}" VerticalAlignment="Center" />
              </StackPanel>
            </DockPanel>
            <Panel Grid.Row="1" Margin="0,8,0,0">
              <ctl:HistoryChart History="{Binding ShownHistory}" RangeHours="{Binding HistoryHours}" MinHeight="120" />
              <TextBlock Text="{Binding HistoryStatus}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextWrapping="Wrap" TextAlignment="Center" IsVisible="{Binding HasHistoryStatus}" />
            </Panel>
            <TextBlock Grid.Row="2" Text="{Binding HistoryBusiest}" FontSize="12" Foreground="{DynamicResource Good}" Margin="0,6,0,0"
                       IsVisible="{Binding HasHistoryBusiest}" />
          </Grid>
        </Border>

        <!-- News -->
        <Border Grid.Row="3" Background="{DynamicResource Panel}" CornerRadius="4" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                IsVisible="{Binding IsNewsDetails}">
          <ScrollViewer DataContext="{Binding SelectedServer}" x:DataType="vm:ServerViewModel">
            <ItemsControl ItemsSource="{Binding News}" Margin="0,4">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NewsItemViewModel">
                  <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,12">
                    <Grid ColumnDefinitions="3,14,*">
                      <Border Grid.Column="0" CornerRadius="2" Background="{DynamicResource Orange}" IsVisible="{Binding Important}" />
                      <StackPanel Grid.Column="2" Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <TextBlock Text="{Binding DateText}" Classes="label" VerticalAlignment="Center" IsVisible="{Binding HasDate}" />
                          <Border Classes="newbadge" Margin="0" IsVisible="{Binding IsNew}"><TextBlock Text="NEW" /></Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Text}" Classes.important="{Binding Important}" />
                        <SelectableTextBlock Text="{Binding Body}" FontSize="13" Foreground="{DynamicResource Silver}" TextWrapping="Wrap"
                                             IsVisible="{Binding HasBody}" />
                        <Button Classes="link" Content="{Binding LinkText}" Command="{Binding OpenLinkCommand}" IsVisible="{Binding HasLink}"
                                HorizontalAlignment="Left" Padding="0,2" ToolTip.Tip="{Binding Item.Link}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <!-- Mods list -->
        <Border Grid.Row="3" Background="{DynamicResource Panel}" CornerRadius="4" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                IsVisible="{Binding IsModsDetails}">
          <Grid>
            <ListBox Classes="mods" DataContext="{Binding SelectedServer}" x:DataType="vm:ServerViewModel" ItemsSource="{Binding Mods}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ModViewModel">
                  <Grid ColumnDefinitions="112,*,90,120,150" ToolTip.Tip="{Binding Tooltip}">
                    <Border Grid.Column="0" Classes="pill" Classes.installed="{Binding IsInstalled}" Classes.update="{Binding IsUpdate}"
                            Classes.missing="{Binding IsMissing}" VerticalAlignment="Center">
                      <TextBlock Text="{Binding StateText}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding IdText}" FontSize="11" Classes="muted" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="12" Foreground="{DynamicResource Silver}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding UpdatedText}" FontSize="12" Classes="muted"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <Button Classes="link" Content="Repair" IsVisible="{Binding CanRepair}"
                              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RepairModCommand}" CommandParameter="{Binding}"
                              ToolTip.Tip="Delete this mod's files and download it fresh through Steam" />
                      <Button Classes="link" Content="Workshop" Command="{Binding OpenWorkshopCommand}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="Waiting for this server's mod list…" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center"
                       DataContext="{Binding SelectedServer}" x:DataType="vm:ServerViewModel" IsVisible="{Binding WaitingForMods}" />
            <TextBlock Text="This server runs no mods (vanilla DayZ)." Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center"
                       DataContext="{Binding SelectedServer}" x:DataType="vm:ServerViewModel" IsVisible="{Binding IsVanilla}" />
          </Grid>
        </Border>
      </Grid>
    </Grid>


    <!-- ============ Body: DayZ Editor ============ -->
    <Grid Grid.Row="1" ColumnDefinitions="390,*" IsVisible="{Binding IsEditorPage}">
      <Border Grid.Column="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto">
          <TextBlock Grid.Row="0" Classes="label" Text="EDITOR PRESETS" Margin="16,16,16,10" />
          <ListBox Grid.Row="1" Classes="servers" Margin="10,0,10,10" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="ed:EditorPreset">
                <Grid ColumnDefinitions="4,*">
                  <Border Classes="accent" Grid.Column="0" Background="Transparent" CornerRadius="4,0,0,4" />
                  <StackPanel Grid.Column="1" Margin="12,10" Spacing="3">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Classes="muted" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <WrapPanel Grid.Row="2" Margin="12,0,12,14">
            <Button Classes="ghost" Content="New" Command="{Binding NewPresetCommand}" Margin="0,0,6,6" ToolTip.Tip="Start an empty preset" />
            <Button Classes="ghost" Content="Import…" Command="{Binding ImportPresetCommand}" Margin="0,0,6,6"
                    ToolTip.Tip="A preset exported from the DayZ launcher (.html), or a text file of Workshop IDs or links" />
            <Button Classes="ghost" Content="Copy" Command="{Binding CopyPresetCommand}" Margin="0,0,6,6" IsEnabled="{Binding HasPreset}"
                    ToolTip.Tip="Make your own editable copy of this preset" />
            <Button Classes="ghost" Content="Delete" Command="{Binding DeletePresetCommand}" Margin="0,0,6,6" IsVisible="{Binding PresetEditable}" />
          </WrapPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1" Margin="26,20,26,12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" IsVisible="{Binding HasPreset}">
        <StackPanel Grid.Row="0" Spacing="6">
          <TextBlock Classes="label" Text="DAYZ EDITOR PRESET" />
          <TextBox Text="{Binding PresetName}" FontSize="20" FontWeight="Bold" IsVisible="{Binding PresetEditable}" MaxLength="80"
                   ToolTip.Tip="Preset name (click to rename)" />
          <TextBlock Text="{Binding PresetName}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" IsVisible="{Binding PresetShared}" />
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="Starts DayZ offline (no server) with CF, Dabs Framework and DayZ-Editor loaded first, then this preset's mods in the order below. Open the Editor from the main menu; save your work there as .dze files." />
          <Border Background="{DynamicResource AccentTint}" BorderBrush="{DynamicResource Orange}" BorderThickness="3,0,0,0" CornerRadius="3" Padding="12,8" Margin="0,4,0,0"
                  IsVisible="{Binding PresetShared}" HorizontalAlignment="Left">
            <TextBlock TextWrapping="Wrap" FontSize="13" Text="Shared by MM staff from the server, so it can't be changed here. Click Copy to make your own version." />
          </Border>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
          <Button Classes="primary" Content="START DAYZ EDITOR" Command="{Binding StartEditorCommand}" IsEnabled="{Binding CanStartEditor}"
                  ToolTip.Tip="Download any missing or outdated mods through Steam, then start DayZ offline with the Editor" />
          <Button Classes="ghost" Content="Update mods" Command="{Binding UpdateEditorModsCommand}" IsEnabled="{Binding CanStartEditor}"
                  ToolTip.Tip="Download and update this preset's mods without starting DayZ" />
          <Button Classes="ghost" Content="Export…" Command="{Binding ExportPresetCommand}"
                  ToolTip.Tip="Save as .html: works in the DayZ launcher, and can be dropped in the agent's editor-presets folder to share it" />
        </StackPanel>

        <!-- Download / launch progress (same panel as on the Servers page) -->
        <Border Grid.Row="2" Classes="sync" Classes.failed="{Binding SyncFailed}" Classes.done="{Binding SyncSucceeded}" Classes.warn="{Binding SyncWarning}"
                IsVisible="{Binding ShowSyncPanel}" Margin="0,14,0,0">
          <StackPanel Spacing="8">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="link" Content="Cancel" Command="{Binding CancelSyncCommand}" IsVisible="{Binding IsSyncing}" />
              <Button DockPanel.Dock="Right" Classes="link" Content="Dismiss" Command="{Binding DismissSyncCommand}" IsVisible="{Binding !IsSyncing}" />
              <Button DockPanel.Dock="Right" Classes="link" Content="Open log" Command="{Binding OpenLogCommand}" IsVisible="{Binding SyncFailed}" />
              <TextBlock Classes="synctitle" Text="{Binding SyncTitle}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
            <ProgressBar IsVisible="{Binding IsSyncing}" Minimum="0" Maximum="1" Value="{Binding SyncFraction}"
                         IsIndeterminate="{Binding SyncIndeterminate}" Foreground="{DynamicResource Orange}" Background="{DynamicResource Line}" Height="6" MinHeight="6" />
            <TextBlock Text="{Binding SyncDetail}" FontSize="12" Foreground="{DynamicResource Silver}" TextWrapping="Wrap"
                       IsVisible="{Binding SyncDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>

        <!-- Adding mods -->
        <StackPanel Grid.Row="3" Spacing="6" Margin="0,16,0,0" IsVisible="{Binding PresetEditable}">
          <TextBlock Classes="label" Text="ADD MODS" />
          <Grid ColumnDefinitions="200,8,*,8,Auto">
            <TextBox Grid.Column="0" Watermark="Filter downloaded mods" Text="{Binding InstalledFilter}" />
            <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" ItemsSource="{Binding InstalledChoices}" SelectedItem="{Binding SelectedInstalled}"
                      PlaceholderText="Pick a downloaded mod">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:InstalledChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="4" Classes="ghost" Content="Add" Command="{Binding AddInstalledModCommand}" />
          </Grid>
          <Grid ColumnDefinitions="*,8,Auto">
            <TextBox Grid.Column="0" Watermark="…or paste Workshop IDs or links (several at once is fine)" Text="{Binding AddModText}" />
            <Button Grid.Column="2" Classes="ghost" Content="Add" Command="{Binding AddModsFromTextCommand}" />
          </Grid>
          <TextBlock Text="{Binding EditorNote}" Foreground="{DynamicResource Warn}" FontSize="12" TextWrapping="Wrap"
                     IsVisible="{Binding EditorNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,18,0,8" Spacing="4">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Classes="label" Text="LOAD ORDER" VerticalAlignment="Bottom" />
            <TextBlock Text="{Binding EditorSummary}" Foreground="{DynamicResource Silver}" FontSize="12" Margin="14,0,0,0" VerticalAlignment="Bottom" />
          </DockPanel>
          <Grid ColumnDefinitions="112,*,90,120,190" Margin="10,10,10,0">
            <TextBlock Grid.Column="0" Classes="label" Text="STATUS" />
            <TextBlock Grid.Column="1" Classes="label" Text="MOD" />
            <TextBlock Grid.Column="2" Classes="label" Text="SIZE" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="3" Classes="label" Text="UPDATED" HorizontalAlignment="Right" />
          </Grid>
        </StackPanel>

        <Border Grid.Row="5" Background="{DynamicResource Panel}" CornerRadius="4" BorderBrush="{DynamicResource Line}" BorderThickness="1">
          <ListBox Classes="mods" ItemsSource="{Binding EditorMods}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ModViewModel">
                <Grid ColumnDefinitions="112,*,90,120,190">
                  <Border Grid.Column="0" Classes="pill" Classes.installed="{Binding IsInstalled}" Classes.update="{Binding IsUpdate}"
                          Classes.missing="{Binding IsMissing}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StateText}" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="always loaded" FontSize="11" Classes="muted" IsVisible="{Binding Locked}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding IdText}" FontSize="11" Classes="muted" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="12" Foreground="{DynamicResource Silver}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding UpdatedText}" FontSize="12" Classes="muted" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" IsVisible="{Binding Editable}">
                      <Button Classes="link" Content="▲" ToolTip.Tip="Load earlier"
                              IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).PresetEditable}"
                              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MoveModUpCommand}" CommandParameter="{Binding}" />
                      <Button Classes="link" Content="▼" ToolTip.Tip="Load later"
                              IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).PresetEditable}"
                              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MoveModDownCommand}" CommandParameter="{Binding}" />
                      <Button Classes="link" Content="Remove"
                              IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).PresetEditable}"
                              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveModCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                    <Button Classes="link" Content="Workshop" Command="{Binding OpenWorkshopCommand}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </Grid>
    </Grid>

    <!-- ============ Body: Mods ============ -->
    <Grid Grid.Row="1" Margin="26,18,26,12" RowDefinitions="Auto,Auto,Auto,Auto,*" IsVisible="{Binding IsModsPage}">
      <DockPanel Grid.Row="0">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="4">
          <Button Classes="tab" Classes.active="{Binding IsInstalledView}" Content="Downloaded" Command="{Binding ShowInstalledViewCommand}" Padding="14,8"
                  ToolTip.Tip="DayZ mods downloaded on this PC" />
          <Button Classes="tab" Classes.active="{Binding IsWorkshopView}" Content="Steam Workshop" Command="{Binding ShowWorkshopViewCommand}" Padding="14,8"
                  ToolTip.Tip="Find and install DayZ mods from the Steam Workshop" />
        </StackPanel>
      </DockPanel>

      <!-- Download / remove progress (same panel as on the other pages) -->
      <Border Grid.Row="1" Classes="sync" Classes.failed="{Binding SyncFailed}" Classes.done="{Binding SyncSucceeded}" Classes.warn="{Binding SyncWarning}"
              IsVisible="{Binding ShowSyncPanel}" Margin="0,14,0,0">
        <StackPanel Spacing="8">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="link" Content="Cancel" Command="{Binding CancelSyncCommand}" IsVisible="{Binding IsSyncing}" />
            <Button DockPanel.Dock="Right" Classes="link" Content="Dismiss" Command="{Binding DismissSyncCommand}" IsVisible="{Binding !IsSyncing}" />
            <Button DockPanel.Dock="Right" Classes="link" Content="Open log" Command="{Binding OpenLogCommand}" IsVisible="{Binding SyncFailed}" />
            <TextBlock Classes="synctitle" Text="{Binding SyncTitle}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" />
          </DockPanel>
          <ProgressBar IsVisible="{Binding IsSyncing}" Minimum="0" Maximum="1" Value="{Binding SyncFraction}"
                       IsIndeterminate="{Binding SyncIndeterminate}" Foreground="{DynamicResource Orange}" Background="{DynamicResource Line}" Height="6" MinHeight="6" />
          <TextBlock Text="{Binding SyncDetail}" FontSize="12" Foreground="{DynamicResource Silver}" TextWrapping="Wrap"
                     IsVisible="{Binding SyncDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>

      <!-- Downloaded: toolbar -->
      <StackPanel Grid.Row="2" Spacing="10" Margin="0,16,0,8" IsVisible="{Binding IsInstalledView}">
        <Grid ColumnDefinitions="260,8,200,*,Auto">
          <TextBox Grid.Column="0" Watermark="Search name or ID" Text="{Binding InstalledSearch}" />
          <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" ItemsSource="{Binding InstalledFilterChoices}" SelectedIndex="{Binding InstalledFilterIndex}" />
          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="Update all" Command="{Binding UpdateAllModsCommand}" IsEnabled="{Binding CanChangeMods}"
                    ToolTip.Tip="Download every mod that has a newer version on the Workshop" />
            <Button Classes="ghost" Content="Remove unused…" Command="{Binding RemoveUnusedModsCommand}" IsEnabled="{Binding CanChangeMods}"
                    ToolTip.Tip="Unsubscribe from and delete mods no MM server, favorite, recent server or editor preset uses" />
            <Button Classes="ghost" Content="Reload" Command="{Binding ShowModsPageCommand}" ToolTip.Tip="Scan the downloaded mods again" />
          </StackPanel>
        </Grid>
        <TextBlock Text="{Binding InstalledSummary}" Foreground="{DynamicResource Silver}" FontSize="12" />
        <Grid ColumnDefinitions="112,*,90,120,150" Margin="10,4,10,0">
          <TextBlock Grid.Column="0" Classes="label" Text="STATUS" />
          <TextBlock Grid.Column="1" Classes="label" Text="MOD" />
          <TextBlock Grid.Column="2" Classes="label" Text="SIZE" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="3" Classes="label" Text="UPDATED" HorizontalAlignment="Right" />
        </Grid>
      </StackPanel>

      <Border Grid.Row="4" Background="{DynamicResource Panel}" CornerRadius="4" BorderBrush="{DynamicResource Line}" BorderThickness="1"
              IsVisible="{Binding IsInstalledView}">
        <Grid>
          <ListBox Classes="mods" ItemsSource="{Binding InstalledMods}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ModViewModel">
                <Grid ColumnDefinitions="112,*,90,120,150" ToolTip.Tip="{Binding UsedByText}">
                  <Border Grid.Column="0" Classes="pill" Classes.installed="{Binding IsInstalled}" Classes.update="{Binding IsUpdate}"
                          Classes.missing="{Binding IsMissing}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StateText}" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="{Binding IdText}" FontSize="11" Classes="muted" />
                      <TextBlock Text="{Binding UsedByShort}" FontSize="11" Classes="muted" IsVisible="{Binding !IsUnused}" />
                      <TextBlock Text="not used by anything" FontSize="11" Foreground="{DynamicResource Warn}" IsVisible="{Binding IsUnused}" />
                    </StackPanel>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="12" Foreground="{DynamicResource Silver}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding UpdatedText}" FontSize="12" Classes="muted" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Classes="link" Content="Remove"
                            IsEnabled="{Binding $parent[Window].((vm:MainViewModel)DataContext).CanChangeMods}"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveInstalledModCommand}" CommandParameter="{Binding}"
                            ToolTip.Tip="Unsubscribe in Steam and delete the files" />
                    <Button Classes="link" Content="Workshop" Command="{Binding OpenWorkshopCommand}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="Loading your mods…" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding InstalledLoading}" />
          <TextBlock Text="{Binding InstalledEmptyText}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !InstalledLoading}" />
        </Grid>
      </Border>

      <!-- Workshop: search -->
      <StackPanel Grid.Row="2" Spacing="10" Margin="0,16,0,10" IsVisible="{Binding IsWorkshopView}">
        <Grid ColumnDefinitions="*,8,200,8,Auto">
          <TextBox Grid.Column="0" Watermark="Search the DayZ Workshop (or paste a Workshop link or ID)" Text="{Binding WorkshopSearch}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SearchWorkshopCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" ItemsSource="{Binding WorkshopSortChoices}" SelectedIndex="{Binding WorkshopSortIndex}"
                    ToolTip.Tip="How to sort when the search box is empty. Searches show the best matches first." />
          <Button Grid.Column="4" Classes="primary" Content="Search" Command="{Binding SearchWorkshopCommand}" />
        </Grid>
        <TextBlock Text="{Binding WorkshopStatus}" Foreground="{DynamicResource Silver}" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>

      <Border Grid.Row="4" Background="{DynamicResource Panel}" CornerRadius="4" BorderBrush="{DynamicResource Line}" BorderThickness="1"
              IsVisible="{Binding IsWorkshopView}">
        <Grid>
          <ScrollViewer>
            <StackPanel>
              <ItemsControl ItemsSource="{Binding WorkshopResults}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:WorkshopRowViewModel">
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,10">
                      <Grid ColumnDefinitions="112,14,*,14,Auto">
                        <Border Grid.Column="0" Width="96" Height="96" CornerRadius="3" ClipToBounds="True" Background="{DynamicResource Panel2}" VerticalAlignment="Top">
                          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Top">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Classes="pill" Classes.installed="{Binding IsInstalled}" Classes.update="{Binding IsUpdate}"
                                    IsVisible="{Binding !NotInstalled}" VerticalAlignment="Center">
                              <TextBlock Text="{Binding StateText}" />
                            </Border>
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          </StackPanel>
                          <TextBlock FontSize="11" Classes="muted" Text="{Binding MetaText}" />
                          <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource Silver}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding RequiresText}" FontSize="11" Foreground="{DynamicResource Warn}" IsVisible="{Binding HasRequires}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Spacing="6" VerticalAlignment="Center" MinWidth="120">
                          <Button Classes="primary" Content="Install" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                  IsVisible="{Binding NotInstalled}"
                                  IsEnabled="{Binding $parent[Window].((vm:MainViewModel)DataContext).CanChangeMods}"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).InstallWorkshopItemCommand}" CommandParameter="{Binding}"
                                  ToolTip.Tip="Subscribe and download through Steam (Steam shows you as playing DayZ while it downloads)" />
                          <Button Classes="primary" Content="Update" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                  IsVisible="{Binding IsUpdate}"
                                  IsEnabled="{Binding $parent[Window].((vm:MainViewModel)DataContext).CanChangeMods}"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).InstallWorkshopItemCommand}" CommandParameter="{Binding}" />
                          <Button Classes="ghost" Content="Open in Steam" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                  Command="{Binding OpenInSteamCommand}" ToolTip.Tip="Open this mod's Workshop page in the Steam app" />
                          <Button Classes="link" Content="Open in browser" HorizontalAlignment="Center" Command="{Binding OpenWorkshopPageCommand}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="ghost" Content="More results" HorizontalAlignment="Center" Margin="0,12" IsVisible="{Binding WorkshopHasMore}"
                      Command="{Binding MoreWorkshopResultsCommand}" />
            </StackPanel>
          </ScrollViewer>
          <TextBlock Text="Searching…" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding WorkshopLoading}" />
        </Grid>
      </Border>
    </Grid>

    <!-- ============ Status bar ============ -->
    <Border Grid.Row="2" Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,6">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="link" Content="{Binding VersionText}" Command="{Binding OpenReleasesCommand}"
                ToolTip.Tip="MM Launcher version. Click to see all releases." />
        <Button DockPanel.Dock="Right" Classes="link" Content="Settings folder" Command="{Binding OpenSettingsFolderCommand}"
                ToolTip.Tip="Open the folder with settings.jsonc and the server cache" />
        <TextBlock DockPanel.Dock="Right" Text="{Binding AgentText}" FontSize="11" Foreground="{DynamicResource Good}" VerticalAlignment="Center" Margin="0,0,14,0" />
        <TextBlock Text="{Binding SteamText}" FontSize="11" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
