<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MMLauncher.App.Views.PasswordDialog"
        Title="Server password"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Icon="avares://MMLauncher/Assets/mm.ico"
        Background="{StaticResource Panel}">
  <StackPanel Margin="22" Spacing="12">
    <TextBlock Text="This server needs a password" FontSize="16" FontWeight="SemiBold" />
    <TextBlock x:Name="ServerName" Classes="muted" FontSize="12" TextWrapping="Wrap" />
    <TextBox x:Name="PasswordBox" PasswordChar="•" Watermark="Password" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Classes="ghost" Content="Cancel" Click="OnCancel" />
      <Button Classes="primary" Content="Join" Click="OnOk" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
