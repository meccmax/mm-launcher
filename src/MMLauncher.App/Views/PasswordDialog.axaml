<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MMLauncher.App.Views.PasswordDialog"
        Title="Server password"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Icon="avares://MMLauncher/Assets/mm.ico"
        Background="{DynamicResource Panel}">
  <StackPanel Margin="22" Spacing="12">
    <TextBlock x:Name="Heading" Text="This server needs a password" FontSize="16" FontWeight="SemiBold" />
    <TextBlock x:Name="ServerName" Classes="muted" FontSize="12" TextWrapping="Wrap" />
    <Grid ColumnDefinitions="*,6,Auto">
      <TextBox x:Name="PasswordBox" PasswordChar="•" Watermark="Password" />
      <Button x:Name="ShowToggle" Grid.Column="2" Classes="ghost" Content="Show" MinWidth="64"
                    Click="OnToggleShow" ToolTip.Tip="Show or hide the password" />
    </Grid>
    <CheckBox x:Name="RememberBox" FontSize="12" Content="Remember this password on this PC"
              ToolTip.Tip="Saved encrypted for your Windows account only, so JOIN SERVER won't ask again. You can show, change or forget it on the server's panel." />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Classes="ghost" Content="Cancel" Click="OnCancel" />
      <Button x:Name="OkButton" Classes="primary" Content="Join" Click="OnOk" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
