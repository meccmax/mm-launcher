<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MMLauncher.App.Views.ConfirmDialog"
        Title="MM Launcher"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Icon="avares://MMLauncher/Assets/mm.ico"
        Background="{DynamicResource Panel}">
  <StackPanel Margin="22" Spacing="12">
    <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock x:Name="MessageText" Foreground="{DynamicResource Silver}" FontSize="13" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
      <Button x:Name="CancelButton" Classes="ghost" Content="Cancel" Click="OnCancel" IsCancel="True" />
      <Button x:Name="OkButton" Classes="primary" Content="OK" Click="OnOk" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
