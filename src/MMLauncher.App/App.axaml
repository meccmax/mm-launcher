<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MMLauncher.App.App"
             RequestedThemeVariant="Dark">

  <!-- Default colors (MM Orange). Every color in the launcher is one of these names; the theme
       picked in Settings replaces them all at start-up (see Themes/AppTheme.cs). -->
  <Application.Resources>
    <SolidColorBrush x:Key="Orange" Color="#FF7A00" />
    <SolidColorBrush x:Key="OrangeSoft" Color="#33FF7A00" />
    <SolidColorBrush x:Key="AccentHover" Color="#FF9533" />
    <SolidColorBrush x:Key="AccentDisabled" Color="#4D2C10" />
    <SolidColorBrush x:Key="AccentDisabledText" Color="#A07A5A" />
    <SolidColorBrush x:Key="OnAccent" Color="#0D0D0F" />
    <SolidColorBrush x:Key="AccentTint" Color="#2A1D12" />
    <SolidColorBrush x:Key="Bg" Color="#0D0D0F" />
    <SolidColorBrush x:Key="Chrome" Color="#09090B" />
    <SolidColorBrush x:Key="Panel" Color="#151518" />
    <SolidColorBrush x:Key="Panel2" Color="#1C1C21" />
    <SolidColorBrush x:Key="Hover" Color="#24242A" />
    <SolidColorBrush x:Key="Stripe" Color="#141417" />
    <SolidColorBrush x:Key="Line" Color="#2A2A31" />
    <SolidColorBrush x:Key="Silver" Color="#C0C4CC" />
    <SolidColorBrush x:Key="Text" Color="#ECECEE" />
    <SolidColorBrush x:Key="Muted" Color="#8C9099" />
    <SolidColorBrush x:Key="Good" Color="#3FB950" />
    <SolidColorBrush x:Key="GoodTint" Color="#16351F" />
    <SolidColorBrush x:Key="GoodTintSoft" Color="#132A19" />
    <SolidColorBrush x:Key="Warn" Color="#E3A21A" />
    <SolidColorBrush x:Key="WarnTint" Color="#3A2C0E" />
    <SolidColorBrush x:Key="WarnTintSoft" Color="#2E2410" />
    <SolidColorBrush x:Key="Bad" Color="#F05A4F" />
    <SolidColorBrush x:Key="BadTint" Color="#3D1916" />
    <SolidColorBrush x:Key="BadTintSoft" Color="#2B1513" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#FF7A00" RegionColor="#0D0D0F" />
        <ColorPaletteResources x:Key="Light" Accent="#D96400" RegionColor="#F3F3F6" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://MMLauncher/Styles.axaml" />
  </Application.Styles>
</Application>
