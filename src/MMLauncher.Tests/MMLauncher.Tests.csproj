<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Self-check program for the launcher's engine. Run it with tools/fake_dayz_servers.py
    running (or pass a real host) to confirm discovery, queries and mod decoding work.
      run-tests.bat                                   (fake servers on localhost)
      run-tests.bat game.misfitmercenaries.com 2000 3000   (real host + port range)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MMLauncher.Core\MMLauncher.Core.csproj" />
    <ProjectReference Include="..\MMServerAgent\MMServerAgent.csproj" />
  </ItemGroup>

</Project>
